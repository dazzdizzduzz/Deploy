# Alamat backend Go. Dibaca di server Next.js saja (Route Handler), bukan di browser.
# Lokal: http://localhost:8080 | Docker Compose: http://backend:8080
API_URL=http://localhost:8080

# Opsional, untuk production di belakang reverse proxy: alamat publik aplikasi web.
# Dipakai saat memeriksa asal permintaan (Origin) bila proxy tidak meneruskan header Host/X-Forwarded-Host.
# APP_ORIGIN=https://ontrack.example.com
