# ==============================================================================
# Database (PostgreSQL)
# ==============================================================================
DB_HOST=db
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=adminpassword
DB_NAME=ontrack_db
DB_SSLMODE=disable

# ==============================================================================
# Server
# ==============================================================================
SERVER_PORT=8080
GIN_MODE=debug

# ==============================================================================
# Keamanan & Autentikasi (JWT RS256)
# ==============================================================================
# Kunci RSA dalam format PEM string.
# Dapat berupa format multiline (diapit tanda kutip dua) atau string satu baris
# dengan literal \n. Jika dibiarkan kosong, server akan membaca file certs/jwt_*.pem.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ==============================================================================
# Absensi
# ==============================================================================
# Zona waktu penentu tanggal kerja dan status terlambat. Kosong = Asia/Jakarta.
# Studio Tigapagi (Sanur) memakai Asia/Makassar.
ATTENDANCE_TIMEZONE=Asia/Makassar

# ==============================================================================
# Object Storage (MinIO / S3-Compatible)
# ==============================================================================
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=admin
S3_SECRET_KEY=adminpassword
S3_BUCKET_NAME=ontrack-bucket
S3_USE_SSL=false
# Opsional: region (default us-east-1), enkripsi sisi server, timeout panggilan (detik).
S3_REGION=
S3_SSE=
S3_TIMEOUT_SECONDS=

# ==============================================================================
# Layanan eksternal Backend 2 (ISSUE-03)
# Aturan: biarkan SEMUA variabel satu layanan kosong agar layanan nonaktif.
# Bila satu variabel diisi, variabel wajib lainnya harus lengkap atau aplikasi berhenti.
# Isi nilai asli hanya di .env (tidak di-commit) atau GitHub Secrets, JANGAN di file ini.
# ==============================================================================

# --- SMTP: email reset kata sandi & verifikasi email Owner ---
# Wajib bila aktif: SMTP_HOST, SMTP_PORT (contoh 587), SMTP_FROM (contoh no-reply@domain).
# SMTP_USERNAME dan SMTP_PASSWORD diisi berpasangan (boleh kosong untuk relay tanpa login).
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TIMEOUT_SECONDS=

# --- FCM: push notification izin & task ---
# FCM_CREDENTIALS_FILE adalah PATH ke file JSON service account, bukan isi JSON-nya.
# Simpan file itu di backend/secrets/ (sudah di-ignore git).
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=

# --- Midtrans: payment gateway (Fase 3) ---
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=

# --- Xendit: payment gateway alternatif (Fase 3) ---
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

# Daftar layanan yang wajib aktif, dipisah koma (contoh untuk production: storage,smtp,fcm).
# Pilihan: storage, smtp, fcm, midtrans, xendit. Kosong = tidak ada yang diwajibkan.
EXTERNAL_SERVICES_REQUIRED=
