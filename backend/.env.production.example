# ==============================================================================
# ONTRACK BACKEND - PRODUCTION ENVIRONMENT TEMPLATE (.env.production)
# ==============================================================================
# Instruksi Deploy:
# 1. Salin berkas ini ke `.env` atau `.env.production` di server target:
#    cp .env.production.example .env.production
# 2. Ganti semua placeholder (YOUR_*) dengan kredensial rahasia production asli.
# 3. Pastikan izin akses berkas aman (contoh: chmod 600 .env.production).
# ==============================================================================

# ==============================================================================
# 1. Server Configuration
# ==============================================================================
SERVER_PORT=8080
# Wajib 'release' di production agar Gin menonaktifkan debug logging & overhead
GIN_MODE=release

# ==============================================================================
# 2. Database (PostgreSQL Production)
# ==============================================================================
DB_HOST=postgres.production.internal
DB_PORT=5432
DB_USER=ontrack_app
DB_PASSWORD=YOUR_STRONG_PRODUCTION_DB_PASSWORD
DB_NAME=ontrack_production
# Di production, wajib enkripsi SSL (require / verify-full / verify-ca)
DB_SSLMODE=require

# ==============================================================================
# 3. Keamanan & Autentikasi (JWT RS256)
# ==============================================================================
# Kunci RSA dalam format PEM string.
# Di production dapat diset via env variable di bawah ini (gunakan format multiline
# ber-tanda kutip ganda atau string dengan literal \n), ATAU letakkan berkas kunci di
# direktori certs/jwt_private.pem dan certs/jwt_public.pem.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_RSA_PRIVATE_KEY_PEM_CONTENT\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_RSA_PUBLIC_KEY_PEM_CONTENT\n-----END PUBLIC KEY-----"

# ==============================================================================
# 4. Modul Absensi & Timezone
# ==============================================================================
# Zona waktu penentu tanggal kerja dan batas terlambat (FR-07/FR-08).
# Studio Tigapagi berlokasi di Sanur, Bali (WITA = Asia/Makassar).
ATTENDANCE_TIMEZONE=Asia/Makassar

# ==============================================================================
# 5. Object Storage (AWS S3 / Production S3-Compatible)
# ==============================================================================
# Digunakan untuk penyimpanan foto absensi selfie (ISSUE-62) & lampiran izin.
S3_ENDPOINT=s3.ap-southeast-1.amazonaws.com
S3_ACCESS_KEY=YOUR_PRODUCTION_S3_ACCESS_KEY
S3_SECRET_KEY=YOUR_PRODUCTION_S3_SECRET_KEY
S3_BUCKET_NAME=ontrack-production-storage
# Wajib true untuk koneksi aman HTTPS di production
S3_USE_SSL=true
S3_REGION=ap-southeast-1
S3_SSE=true
S3_TIMEOUT_SECONDS=10

# ==============================================================================
# 6. Layanan Eksternal (ISSUE-03)
# ==============================================================================

# --- SMTP: Notifikasi Email, Reset Password & Verifikasi Akun Owner ---
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=YOUR_SENDGRID_OR_SMTP_PASSWORD
SMTP_FROM="OnTrack <no-reply@ontrack.id>"
SMTP_TIMEOUT_SECONDS=10

# --- FCM: Push Notifications (Firebase Cloud Messaging) ---
FCM_PROJECT_ID=ontrack-production
# Simpan file JSON service account di direktori backend/secrets/ (chmod 600)
FCM_CREDENTIALS_FILE=secrets/firebase-service-account.json

# --- Midtrans: Payment Gateway (Fase 3 - Production) ---
MIDTRANS_SERVER_KEY=YOUR_MIDTRANS_PRODUCTION_SERVER_KEY
MIDTRANS_CLIENT_KEY=YOUR_MIDTRANS_PRODUCTION_CLIENT_KEY
MIDTRANS_IS_PRODUCTION=true

# --- Xendit: Payment Gateway Alternatif (Fase 3) ---
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

# ==============================================================================
# 7. Validasi Layanan Wajib (Health check saat startup)
# ==============================================================================
# Daftar layanan yang WAJIB aktif saat backend dinyalakan di production.
# Jika ada konfigurasi yang kurang lengkap, backend akan menolak boot demi keselamatan data.
EXTERNAL_SERVICES_REQUIRED=storage,smtp
